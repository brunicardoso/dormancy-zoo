# pixi environment
.pixi/
*.egg-info/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
# run outputs (weights, checkpoints) stay local
/runs/
# weights never go to git, wherever they are
*.safetensors
*.pt
*.bin
*.ckpt
# local data / caches
data_cache/
*.Zone.Identifier
*:Zone.Identifier
logs/
# Drive upload staging (weights; never committed)
export/

# lock file for concurrent manifest appends (zoo.runs)
*.csv.lock

# per-run Colab files: not published for now (PI 2026-11-18); they stay in the history of main before this point,
# on disk where they were imported, and are listed with their checksums in results/colab/<queue>/files.sha256
results/colab/*/runs/
